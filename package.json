{
  "name": "kntq-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "today": "tsx src/cli/today.ts",
    "collect": "tsx src/collector/cli.ts collect",
    "daily": "tsx src/collector/cli.ts daily",
    "weekly": "tsx src/collector/cli.ts weekly",
    "rebuild": "tsx src/collector/cli.ts rebuild",
    "backfill": "tsx src/collector/backfill.ts"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
